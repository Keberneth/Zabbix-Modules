{
  "manifest_version": 2.0,
  "id": "capacity_planning",
  "name": "Capacity Planning & Prediction",
  "namespace": "CapacityPlanning",
  "version": "1.4.0",
  "author": "Keberneth",
  "description": "Evidence-based disk, CPU and RAM capacity analysis with recurring peak episodes, maintenance-aware state, filters, secure shared caching and zoomable modal charts.",
  "actions": {
    "capacity.planning.view": {
      "class": "CapacityPlanningView",
      "view": "capacity.planning.view"
    },
    "capacity.planning.data": {
      "class": "CapacityPlanningData",
      "layout": "layout.json"
    },
    "capacity.planning.settings.save": {
      "class": "CapacityPlanningSettingsSave",
      "layout": "layout.json"
    },
    "capacity.planning.cache.status": {
      "class": "CapacityPlanningCacheStatus",
      "layout": "layout.json"
    }
  },
  "assets": {
    "css": [
      "capacity-planning.css"
    ],
    "js": [
      "capacity-planning-1.4.0-20260801.1.js"
    ]
  },
  "config": {
    "cache": {
      "enabled": true,
      "ttl_seconds": 1800
    }
  }
}
