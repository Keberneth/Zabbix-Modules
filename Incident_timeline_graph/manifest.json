{
  "manifest_version": 2.0,
  "id": "incident_timeline_graph",
  "name": "Incident Timeline Graph",
  "namespace": "IncidentTimeline",
  "version": "1.4.0",
  "author": "Keberneth",
  "description": "Interactive multi-month incident timeline and top-triggers report with host/group/template/name filtering, severity charts, drill-down and export options.",
  "actions": {
    "incident.timeline.view": {
      "class": "IncidentTimelineView",
      "view": "incident.timeline.view"
    },
    "incident.timeline.data": {
      "class": "IncidentTimelineData",
      "layout": "layout.json"
    }
  },
  "assets": {
    "css": [
      "incident-timeline-1.4.0.css"
    ],
    "js": [
      "incident-timeline-1.4.0.js"
    ]
  }
}
