# Copy to /etc/sysconfig/zabbix-netbox-sync (RHEL family) or
# /etc/default/zabbix-netbox-sync (Debian family), then set mode 0600.
# The token variable names must match those saved on the module settings page.
NETBOXSYNC_ZABBIX_API_TOKEN=replace-with-zabbix-api-token

# Optional: use an environment-backed NetBox token too.
# NETBOX_API_TOKEN=replace-with-netbox-api-token

# Optional: direct HashiCorp Vault KV v2 lookup. In Integrations, select
# vault:secret/data/netbox#api_token and vault:secret/data/zabbix#api_token.
# Configure the same settings for PHP-FPM to use browser tests/manual runs.
# Set exactly one of TOKEN_FILE or TOKEN; restrict the token's Vault read policy.
# NETBOXSYNC_VAULT_ADDR=https://vault.example.com:8200
# NETBOXSYNC_VAULT_TOKEN_FILE=/etc/zabbix/netboxsync-vault-token
# NETBOXSYNC_VAULT_TOKEN=replace-with-restricted-vault-token
# NETBOXSYNC_VAULT_NAMESPACE=team
# NETBOXSYNC_VAULT_CACERT=/etc/zabbix/vault-ca.pem

# Optional: Vault Agent renders files in this dedicated, protected directory.
# In Integrations, select file:netbox-token and file:zabbix-api-token instead
# of the environment references above. Both the CLI and PHP-FPM need access.
# NETBOXSYNC_SECRET_DIR=/run/netboxsync-secrets
# Additional environment names explicitly approved for API/shared secrets:
# NETBOXSYNC_ALLOWED_SECRET_ENV_VARS=MY_NETBOX_TOKEN,MY_ZABBIX_API_TOKEN

# Optional when zabbix.conf.php is not in a standard frontend path.
# ZABBIX_WEB_CONFIG=/etc/zabbix/web/zabbix.conf.php

# Required only when the Zabbix frontend obtains its DB credentials from Vault.
# NETBOXSYNC_ZABBIX_DB_USER=zabbix
# NETBOXSYNC_ZABBIX_DB_PASSWORD=replace-with-database-password
