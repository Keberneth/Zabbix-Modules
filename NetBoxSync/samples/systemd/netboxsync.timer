[Unit]
Description=Run the Zabbix → NetBox synchronization on a schedule
Documentation=https://github.com/Keberneth/Zabbix-Modules

[Timer]
# Wait 15 minutes after each completed run. The module also enforces per-sync
# intervals, so a frequent timer just means "check what is due".
OnBootSec=2min
OnUnitInactiveSec=15min
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
