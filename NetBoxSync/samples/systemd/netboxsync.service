[Unit]
Description=Zabbix → NetBox synchronization run (NetBoxSync module runner)
Documentation=https://github.com/Keberneth/Zabbix-Modules
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Use the same account that owns the state/log directories and can read the
# Zabbix frontend DB configuration. Debian/Ubuntu usually uses www-data.
User=apache
Group=apache

# Optional environment-backed NetBox/Zabbix tokens, ZABBIX_WEB_CONFIG, and
# standalone DB credentials for Vault-backed frontend configurations.
# Keep this file root-owned and not world-readable. On Debian/Ubuntu use
# /etc/default/zabbix-netbox-sync and update this path.
EnvironmentFile=/etc/sysconfig/zabbix-netbox-sync
WorkingDirectory=/usr/share/zabbix/modules/NetBoxSync
ExecStart=/usr/bin/php /usr/share/zabbix/modules/NetBoxSync/bin/netboxsync.php --json
TimeoutStartSec=30min
UMask=0007

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/zabbix-netbox-sync /var/log/zabbix-netbox-sync
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
